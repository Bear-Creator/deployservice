# DeployService API Configuration

# API Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Terraform
TERRAFORM_DIR=terraform

# Ansible
ANSIBLE_DIR=ansible
ANSIBLE_INVENTORY_DIR=ansible/inventory

# Backup
BACKUP_DIR=backups

# Callback
CALLBACK_TIMEOUT=30
CALLBACK_RETRIES=3

# Security
ALLOWED_HOSTS=["*"] 